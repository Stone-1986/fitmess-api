            "header": [],
            "url": {
              "raw": "{{baseUrl}}/exercises/00000000-0000-4000-8000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["exercises", "00000000-0000-4000-8000-000000000000"]
            }
          }
        },
        {
          "name": "Detalle con id no-UUID — 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "",
                  "pm.test('Content-Type problem+json', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/exercises/no-es-un-uuid",
              "host": ["{{baseUrl}}"],
              "path": ["exercises", "no-es-un-uuid"]
            },
            "description": "`ParseUUIDPipe` rechaza el parámetro antes de llegar al service."
          }
        }
      ]
    },
    {
      "name": "HU-006 — Modificar ejercicio",
      "description": "PATCH /exercises/:id. `name` se actualiza in-place sobre `Exercise` (identidad). `description`/`muscleGroup` crean versión nueva (CA-006-1) o editan la vigente in-place (CA-006-3) según si el ejercicio ya se usó en un plan.",
      "item": [
        {
          "name": "Renombrar ejercicio — 200",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = pm.collectionVariables.get('runSuffix');",
                  "pm.collectionVariables.set('exerciseName', `Sentadilla trasera con barra ${s}`);"
                ]
              }
            },
            {
