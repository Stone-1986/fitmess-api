generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums base ---

enum UserRole {
  ADMIN
  COACH
  ATHLETE
}

// RN-27: exactamente estos cuatro estados, sin sub-estados adicionales.
// ARCHIVED es uno de ellos -- Plan (EPICA-03) NO lleva un campo `archivedAt`
// separado, seria una segunda fuente de verdad para "esta archivado"
// (decision D-7b del plan de implementacion de EPICA-03).
enum PlanStatus {
  DRAFT
  PUBLISHED
  FINALIZED
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
}

// --- Enums EPICA-01 ---

enum CoachRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  HABEAS_DATA
  TERMS_OF_SERVICE
  HEALTH_DATA_CONSENT
  SPORT_CONSENT
}

enum IdentificationType {
  CC
  CE
  NIT
  PASAPORTE
  PPT
  PEP
}

// --- Modelos EPICA-01 ---

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique @map("email")
  passwordHash           String             @map("password_hash")
  role                   UserRole           @map("role")
  name                   String             @map("name")
  phone                  String             @map("phone")
  phoneCountryCode       String             @map("phone_country_code")
  identificationType     IdentificationType @map("identification_type")
  identificationNumber   String             @unique @map("identification_number")
  avatarUrl              String?            @map("avatar_url")
  dateOfBirth            DateTime?          @map("date_of_birth")
  failedLoginAttempts    Int                @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?          @map("locked_until")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  coachRequest                CoachRequest?      @relation("CoachRequestUser")
  reviewedCoachRequests       CoachRequest[]     @relation("CoachRequestReviewer")
  legalAcceptances             LegalAcceptance[]
  refreshTokens                RefreshToken[]
  adminInvitationsCreated     AdminInvitation[]  @relation("AdminInvitationInvitedBy")
  plans                        Plan[]

  @@map("users")
}

model CoachRequest {
  id              String             @id @default(uuid())
  userId          String             @unique @map("user_id")
  planDescription String             @map("plan_description")
  bannerUrl       String?            @map("banner_url")
  status          CoachRequestStatus @default(PENDING) @map("status")
  rejectionReason String?            @map("rejection_reason")
  reviewedAt      DateTime?          @map("reviewed_at")
  reviewedBy      String?            @map("reviewed_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user            User               @relation("CoachRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User?              @relation("CoachRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("coach_requests")
}

// Registro inmutable — append-only (Ley 527/1999)
// No tiene updatedAt por diseño: este registro nunca debe modificarse
model LegalAcceptance {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  documentType    DocumentType @map("document_type")
  documentVersion String       @map("document_version")
  ip              String       @map("ip")
  userAgent       String       @map("user_agent")
  planId          String?      @map("plan_id")
  acceptedAt      DateTime     @default(now()) @map("accepted_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("legal_acceptances")
}

// Registro append-only — sin updatedAt
model AuditLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  ip            String   @map("ip")
  userAgent     String   @map("user_agent")
  method        String   @map("method")
  url           String   @map("url")
  statusCode    Int?     @map("status_code")
  duration      Int?     @map("duration")
  correlationId String?  @map("correlation_id")
  error         String?  @map("error")

  // Que recursos toco el request. Sin esto, una busqueda cuyos criterios viajan
  // en el body (POST /coach-requests/search) deja constancia de que ALGUIEN
  // busco, pero no sobre los datos de QUIEN — y las reglas prohiben registrar el
  // body. Ante un reclamo de habeas data ("¿quien consulto mis datos?") el
  // rastro era insuficiente para esas rutas (hallazgo #9).
  //
  // Se guardan los IDs DEVUELTOS, no los criterios buscados: la pregunta legal
  // es quien accedio a los datos del titular, y una busqueda sin resultados no
  // divulgo nada. Los IDs si pueden registrarse; nombres, emails y documentos no.
  resourceType  String?  @map("resource_type")
  resourceIds   String[] @map("resource_ids")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([correlationId])
  // GIN: responde "¿quien consulto los datos de X?" con `resource_ids @> '{X}'`.
  // Un btree no sirve para contencion en arrays.
  @@index([resourceIds], type: Gin)
  @@map("audit_logs")
}

// Registro append-only — sin updatedAt
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// --- Modelos EPICA-09 ---

// Registro append-only — sin updatedAt (Ley 1273/2009)
// El estado es derivado en el service: USED si tokenUsedAt != null,
// EXPIRED si expiresAt < now(), ACTIVE en caso contrario.
// tokenUsedAt es la unica escritura posterior al INSERT — marca consumo atomico del token.
model AdminInvitation {
  id           String    @id @default(uuid())
  email        String    @map("email")
  tokenHash    String    @unique @map("token_hash")
  invitedBy    String    @map("invited_by")
  expiresAt    DateTime  @map("expires_at")
  tokenUsedAt  DateTime? @map("token_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  inviter      User      @relation("AdminInvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)

  // Indice para la query de verificacion de invitacion activa:
  // WHERE email = ? AND token_used_at IS NULL AND expires_at > now()
  @@index([email])
  @@map("admin_invitations")
}

// --- Modelos EPICA-02 ---

// Biblioteca global de ejercicios. `name` es la identidad del catalogo y vive
// aqui (no en ExerciseVersion): no se versiona, a diferencia de description/
// muscleGroup, que son contenido de entrenamiento (RN-05). Decision aceptada
// por el humano el 2026-08-05: corregir una errata de nombre debe propagarse
// a los planes historicos que ya referencian este ejercicio.
//
// Unicidad de `name`: SOLO entre ejercicios ACTIVOS, case-insensitive
// (CA-005-2/CA-005-6). NO se declara `@unique` en el campo ni un
// `@@unique([name])` a nivel de modelo — cualquiera de los dos rechazaria
// altas legitimas que CA-005-6 permite explicitamente (el nombre de un
// ejercicio inhabilitado queda libre para uno nuevo). La regla real requiere
// un indice UNICO PARCIAL con funcion (lower(name) ... WHERE is_active),
// que el schema declarativo de Prisma no puede expresar (no soporta indices
// funcionales ni parciales). Ver bloque de instrucciones abajo.
//
// ============================================================================
// INDICE PARCIAL REQUERIDO — el humano lo agrega a mano en la migracion:
//
//   CREATE UNIQUE INDEX "exercises_name_lower_active_key"
//     ON "exercises" (lower("name"))
//     WHERE "is_active" = true;
//
// Por que `lower("name")` sin trim(): el service SIEMPRE persiste `name` ya
// trimeado (create() y el rename de update()), asi que la columna nunca
// contiene espacios al inicio/fin — trim() en el indice seria redundante.
//
// Workflow recomendado (patron oficial de Prisma "Customizing migrations"):
//   1. pnpm prisma migrate dev --create-only --name add_exercises_catalog
//   2. Editar el migration.sql generado: pegar el CREATE UNIQUE INDEX de
//      arriba al final del archivo, despues de que Prisma cree la tabla
//      "exercises" y antes/despues de crear "exercise_versions" (el orden
//      entre ambas tablas no importa, solo que "exercises" ya exista).
//   3. pnpm prisma migrate dev   (aplica la migracion ya editada)
//
// Sobrevivencia ante un futuro `prisma migrate dev`: SI sobrevive. El motor
// de diff de Prisma Migrate opera sobre su representacion interna del
// datamodel (modelos/campos/@@index/@@unique declarados en schema.prisma),
// reconstruida contra una shadow database que re-ejecuta el historial de
// migraciones. Un indice parcial con WHERE no es expresable en esa
// representacion — es literalmente invisible para el motor de diff, que
// nunca genera un DROP INDEX para algo que no reconoce como "propio" del
// schema. Esto se mantiene SIEMPRE que:
//   (a) el archivo de migracion con este SQL crudo permanezca en
//       prisma/migrations/ sin editar ni borrar — se re-ejecuta en cada
//       `prisma migrate reset` o reconstruccion de la shadow database;
//   (b) nadie corra `prisma db pull` sobre la tabla "exercises" — la
//       introspeccion inversa no reconstruye la clausula WHERE (Prisma no
//       soporta indices parciales en el schema declarativo) y sobreescribiria
//       schema.prisma desincronizandolo del estado real de la base de datos;
//   (c) nadie agregue `@unique` en `name` o `@@unique([name])` a este modelo
//       en una migracion futura — colisionaria con este indice parcial (dos
//       constraints de unicidad con semantica distinta sobre la misma
//       columna).
// Nota de rendimiento (no de correccion): el pre-check de unicidad en el
// service usa `where: { name: { equals, mode: 'insensitive' }, isActive:
// true }`, que Prisma traduce en PostgreSQL a `name ILIKE $1`, no a
// `lower(name) = $1`. Este indice parcial puede no ser aprovechado por el
// planner para ESA consulta especifica — es un tema de query-shape en el
// service, no un defecto del indice. Su funcion critica (cerrar la ventana
// de carrera a nivel de base de datos junto con el catch de P2002) es
// independiente de como se planifique el SELECT de precheck.
// ============================================================================
model Exercise {
  id        String   @id @default(uuid())
  name      String   @map("name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions  ExerciseVersion[]

  // Cubre GET /exercises (filtro por defecto isActive=true, paginado).
  // No se agrega indice propio sobre `name`: la unica consulta que filtra por
  // el, el pre-check de unicidad de create()/rename, ya queda cubierta por el
  // indice parcial de arriba en el caso comun, y no hay busqueda de texto
  // libre por name en el alcance de esta epica.
  @@index([isActive])
  @@map("exercises")
}

// Contenido versionado del ejercicio (RN-05): description y muscleGroup.
// A diferencia de LegalAcceptance (estrictamente append-only, cero UPDATE en
// todo el codebase), ExerciseVersion SI recibe una escritura UPDATE real:
// CA-006-3 edita in-place la version vigente (`exerciseVersion.update(...)`)
// mientras isUsedInPlan() sea false. Solo cuando el ejercicio ya esta en uso
// en un plan, update() pasa a comportarse append-only y crea una version
// nueva (CA-006-1) en vez de tocar la existente. Por eso SI lleva `updatedAt`
// -- omitirlo ocultaria cuando fue la ultima edicion in-place de la version
// vigente, informacion real que el service produce. Las versiones que ya
// fueron superadas por una mas reciente nunca vuelven a escribirse (ni
// siquiera su updatedAt cambia despues de quedar "vieja").
model ExerciseVersion {
  id            String   @id @default(uuid())
  exerciseId    String   @map("exercise_id")
  versionNumber Int      @map("version_number")
  description   String   @map("description")
  muscleGroup   String   @map("muscle_group")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // onDelete: Cascade — Exercise + ExerciseVersion son un unico agregado
  // (siempre se crean juntos en la misma $transaction; una ExerciseVersion
  // no tiene sentido sin su Exercise). Si algun dia se agrega un hard-delete
  // administrativo de Exercise (no expuesto en esta epica), sus versiones
  // deben desaparecer con el, igual que el patron ya usado en
  // CoachRequest/LegalAcceptance/RefreshToken -> User de este mismo schema.
  // NOTA (EPICA-03): esta cascada queda en tension deliberada con
  // SessionExercise.exerciseVersion (onDelete: Restrict) — ver el
  // comentario de ese modelo. Postgres bloquea el borrado de un Exercise
  // en cuanto alguna de sus versiones siga referenciada por un plan.
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  // Uso desde EPICA-03: una version puede ser referenciada por multiples
  // SessionExercise (el mismo ejercicio agregado a distintas sesiones o
  // planes mientras esa version siga vigente).
  sessionExercises SessionExercise[]

  // Cubre la consulta "version vigente" (orderBy versionNumber desc, take 1
  // filtrando por exerciseId) sin indice adicional: exerciseId es la columna
  // lider del indice compuesto que este @@unique ya crea. No se agrega un
  // puntero denormalizado currentVersionId en Exercise (ver decision del
  // plan de implementacion de EPICA-02).
  @@unique([exerciseId, versionNumber])
  @@map("exercise_versions")
}

// --- Modelos EPICA-03 ---

// Plan de entrenamiento (plantilla base del entrenador). Jerarquia completa
// confirmada por el humano el 2026-08-20: Plan -> Phase -> Week -> Session ->
// SessionExercise (RN-08). PlanStatus (enum arriba) ya trae exactamente los
// cuatro estados de RN-27 — NO se agrega `archivedAt`: ARCHIVED es uno de
// esos cuatro valores, no un flag de soft-delete adicional (decision D-7b
// del plan de implementacion). Tampoco existe una tabla `planHistory`: el
// rastro de mutaciones HTTP ya lo cubre AuditLog via AuditMiddleware
// (decision D-7c) — ninguna CA de esta epica pide un historial de
// transiciones distinto de eso.
model Plan {
  id          String     @id @default(uuid())
  name        String     @map("name")
  description String?    @map("description")
  startDate   DateTime?  @map("start_date")
  endDate     DateTime?  @map("end_date")
  status      PlanStatus @default(DRAFT) @map("status")
  coachId     String     @map("coach_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // onDelete: Restrict (no Cascade) — a diferencia de CoachRequest/
  // RefreshToken/LegalAcceptance (artefactos de identidad 1:1 con el
  // usuario), un Plan es contenido de negocio sustantivo que EPICA-04/05
  // referenciaran desde Subscription/SessionResult. Hoy no existe ningun
  // endpoint que borre un User, pero si alguna vez se agrega uno
  // administrativo, no debe poder arrastrar en cascada silenciosa los
  // planes (potencialmente publicados y visibles a atletas) de un
  // entrenador — mismo criterio ya usado en AdminInvitation.inviter.
  coach  User    @relation(fields: [coachId], references: [id], onDelete: Restrict)
  phases Phase[]

  // Cubre GET /plans (listado propio del entrenador, todos los estados).
  @@index([coachId])
  // Cubre el query mas caliente de la epica (HU-011, decision D-1): el
  // catalogo filtra SIEMPRE por `status = PUBLISHED AND endDate >= now()`
  // a nivel de query (evaluacion perezosa de Finalizado, sin job
  // programado). Columna de igualdad (status) primero, columna de rango
  // (endDate) despues — orden estandar para que un solo indice compuesto
  // sirva al filtro completo.
  @@index([status, endDate])
  @@map("plans")
}

// Fase de un plan (mesociclo: 3-8 semanas con un enfasis de entrenamiento,
// segun periodizacion NSCA — ver reporte de validacion de negocio).
// Estructura pura: hard-delete real en cascada mientras el plan sigue en
// Borrador (decision D-7); tras publicar, RN-31 la vuelve inmutable y ya no
// existe ninguna ruta de escritura que la toque. Por eso Phase/Week/Session/
// SessionExercise NO llevan `updatedAt`: ninguna tiene un endpoint de
// edicion — agregar la columna solo esconderia que nunca cambia despues del
// INSERT.
model Phase {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  name      String   @map("name")
  order     Int      @map("order")
  createdAt DateTime @default(now()) @map("created_at")

  plan  Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  weeks Week[]

  // Ancla para la FK compuesta de Week -> Phase (ver Week.phase abajo). No
  // sirve para busquedas por planId (id es la columna lider de este
  // indice) — esa consulta ya queda cubierta por @@unique([planId, order]).
  @@unique([id, planId])
  // order es calculado server-side (maximo existente en el plan + 1,
  // decision D-5). Esta unicidad por padre no es solo un indice de
  // rendimiento: es una salvaguarda de integridad contra dos altas
  // concurrentes de fase calculando el mismo "siguiente" order antes de que
  // la primera se persista. La columna lider (planId) ademas cubre "listar
  // fases de un plan" sin necesitar un indice adicional.
  @@unique([planId, order])
  @@map("phases")
}

// Semana (microciclo, segun periodizacion NSCA). weekNumber es secuencial a
// lo largo de TODO el plan, no reinicia por fase (decision D-4) — EPICA-05
// (WeekClosure, sensaciones semanales) lo necesita para comparar semanas
// entre fases.
//
// planId esta DENORMALIZADO desde phase.planId — recomendacion del
// Arquitecto, evaluada aqui y ACEPTADA, pero no a ciegas: la unicidad de
// weekNumber por plan (`@@unique([planId, weekNumber])`) es inexpresable en
// Prisma sin un campo planId propio en este modelo, porque el schema
// declarativo no puede construir una constraint de unicidad atravesando una
// relacion (Week -> Phase -> Plan). Rechazar la denormalizacion habria
// dejado esa unicidad como responsabilidad exclusiva del service (un
// SELECT+INSERT dentro de una transaccion, sin ninguna garantia a nivel de
// base de datos) — un nivel de proteccion inferior al que ya existe para el
// nombre de Exercise en EPICA-02.
//
// La inconsistencia que la denormalizacion podria introducir (una Week cuyo
// planId no coincida con el planId real de su Phase) queda cerrada A NIVEL
// DE BASE DE DATOS, no solo por disciplina del service: la relacion de abajo
// es una FK COMPUESTA `(phaseId, planId) -> Phase(id, planId)`, apoyada en
// `Phase.@@unique([id, planId])`. Postgres exige que el par exacto
// (phaseId, planId) exista como una fila real de Phase — es imposible
// insertar o actualizar una Week con un planId que no sea el de su propia
// Phase; el motor la rechaza con una violacion de FK ante cualquier intento,
// no solo cuando el service se equivoca.
model Week {
  id         String   @id @default(uuid())
  phaseId    String   @map("phase_id")
  planId     String   @map("plan_id")
  weekNumber Int      @map("week_number")
  createdAt  DateTime @default(now()) @map("created_at")

  phase    Phase     @relation(fields: [phaseId, planId], references: [id, planId], onDelete: Cascade)
  sessions Session[]

  @@unique([planId, weekNumber])
  @@index([phaseId])
  @@map("weeks")
}

// Sesion de entrenamiento dentro de una semana.
model Session {
  id        String   @id @default(uuid())
  weekId    String   @map("week_id")
  name      String   @map("name")
  order     Int      @map("order")
  createdAt DateTime @default(now()) @map("created_at")

  week      Week              @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises SessionExercise[]

  // Mismo criterio que Phase.@@unique([planId, order]): order es
  // server-side y su unicidad por padre (aqui, por semana) es salvaguarda
  // de integridad, no solo indice de rendimiento; la columna lider (weekId)
  // cubre ademas "listar sesiones de una semana".
  @@unique([weekId, order])
  @@map("sessions")
}

// Ejercicio dentro de una sesion del plan. Referencia SIEMPRE
// exerciseVersionId, NUNCA un exerciseId directo — es como se cumple RN-07:
// un plan conserva la version del ejercicio vigente al momento de agregarlo,
// aunque la biblioteca global lo modifique o inhabilite despues. Ningun otro
// campo de ejecucion (series, repeticiones, descanso) esta definido: ninguna
// HU/CA de esta epica los pide — se deja para una HU/epica futura si el
// negocio los requiere (ver riesgos del plan de implementacion).
model SessionExercise {
  id                String   @id @default(uuid())
  sessionId         String   @map("session_id")
  exerciseVersionId String   @map("exercise_version_id")
  order             Int      @map("order")
  createdAt         DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // onDelete: Restrict — un plan historico NUNCA debe perder esta
  // referencia. Hoy no existe ningun endpoint que borre una ExerciseVersion
  // ni un hard-delete de Exercise, pero Exercise -> ExerciseVersion SI es
  // Cascade (EPICA-02): si algun dia se agrega un hard-delete administrativo
  // de Exercise, este Restrict actua como salvaguarda de base de datos —
  // Postgres bloquea esa cascada en cuanto encuentra una ExerciseVersion
  // todavia referenciada por un SessionExercise, obligando a que la
  // decision de borrar pase primero por isUsedInPlan() en el service, igual
  // que ya exige EPICA-02 para inhabilitar un ejercicio en uso.
  exerciseVersion ExerciseVersion @relation(fields: [exerciseVersionId], references: [id], onDelete: Restrict)

  // order es server-side; unicidad por sesion, mismo criterio que Phase/Session.
  @@unique([sessionId, order])
  // Indice critico: isUsedInPlan(exerciseId) (decision D-2 del plan) hace
  // `sessionExercise.count({ where: { exerciseVersion: { exerciseId } } })`,
  // que hace JOIN contra exercise_versions y filtra session_exercises por
  // exercise_version_id. Este query corre en CADA PATCH de ejercicio (nota
  // explicita del plan de implementacion) — sin este indice seria un seq
  // scan de session_exercises en cada edicion del catalogo.
  @@index([exerciseVersionId])
  @@map("session_exercises")
}
