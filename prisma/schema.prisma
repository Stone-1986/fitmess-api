generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums base ---

enum UserRole {
  ADMIN
  COACH
  ATHLETE
}

// RN-27: exactamente estos cuatro estados, sin sub-estados adicionales.
// ARCHIVED es uno de ellos -- Plan (EPICA-03) NO lleva un campo `archivedAt`
// separado, seria una segunda fuente de verdad para "esta archivado"
// (decision D-7b del plan de implementacion de EPICA-03).
enum PlanStatus {
  DRAFT
  PUBLISHED
  FINALIZED
  ARCHIVED
}

// RN-27 (EPICA-04): exactamente estos cuatro estados. NO se agrega un
// quinto valor (p.ej. `CONSENT_PENDING`) para representar "Aprobada pero
// esperando el consentimiento deportivo de HU-014" — esa espera ya es
// observable como status=APPROVED + activatedAt=null, sin necesidad de un
// estado adicional. Decision confirmada por el humano el 2026-08-20:
// no se toca este enum. El diagrama de Subscription Lifecycle en el skill
// design-patterns (SKILL.md §2) documenta hoy un quinto estado intermedio
// que NO existe aqui — es una desactualizacion del skill, no de este schema
// (ver riesgos del plan de implementacion de EPICA-04).
enum SubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
}

// --- Enums EPICA-01 ---

enum CoachRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  HABEAS_DATA
  TERMS_OF_SERVICE
  HEALTH_DATA_CONSENT
  SPORT_CONSENT
}

enum IdentificationType {
  CC
  CE
  NIT
  PASAPORTE
  PPT
  PEP
}

// --- Modelos EPICA-01 ---

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique @map("email")
  passwordHash           String             @map("password_hash")
  role                   UserRole           @map("role")
  name                   String             @map("name")
  phone                  String             @map("phone")
  phoneCountryCode       String             @map("phone_country_code")
  identificationType     IdentificationType @map("identification_type")
  identificationNumber   String             @unique @map("identification_number")
  avatarUrl              String?            @map("avatar_url")
  dateOfBirth            DateTime?          @map("date_of_birth")
  failedLoginAttempts    Int                @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?          @map("locked_until")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  coachRequest                CoachRequest?      @relation("CoachRequestUser")
  reviewedCoachRequests       CoachRequest[]     @relation("CoachRequestReviewer")
  legalAcceptances             LegalAcceptance[]
  refreshTokens                RefreshToken[]
  adminInvitationsCreated     AdminInvitation[]  @relation("AdminInvitationInvitedBy")
  plans                        Plan[]
  subscriptions                Subscription[]    @relation("SubscriptionAthlete")
  reviewedSubscriptions        Subscription[]    @relation("SubscriptionReviewer")
  // EPICA-05: lado inverso de PlanInstance.athlete y SessionResult.athlete.
  // Una sola relacion hacia cada modelo — sin @relation nombrado, mismo
  // criterio que Plan.coach.
  planInstances                 PlanInstance[]
  sessionResults                SessionResult[]

  @@map("users")
}

model CoachRequest {
  id              String             @id @default(uuid())
  userId          String             @unique @map("user_id")
  planDescription String             @map("plan_description")
  bannerUrl       String?            @map("banner_url")
  status          CoachRequestStatus @default(PENDING) @map("status")
  rejectionReason String?            @map("rejection_reason")
  reviewedAt      DateTime?          @map("reviewed_at")
  reviewedBy      String?            @map("reviewed_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user            User               @relation("CoachRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User?              @relation("CoachRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("coach_requests")
}

// Registro inmutable — append-only (Ley 527/1999)
// No tiene updatedAt por diseño: este registro nunca debe modificarse
model LegalAcceptance {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  documentType    DocumentType @map("document_type")
  documentVersion String       @map("document_version")
  ip              String       @map("ip")
  userAgent       String       @map("user_agent")
  // EPICA-04/D-5: FK real a Plan (antes String? sin relation — un planId
  // invalido entraba sin error). Sigue opcional: HABEAS_DATA y
  // TERMS_OF_SERVICE (EPICA-01) se registran sin plan asociado, solo
  // SPORT_CONSENT (HU-014) lo usa. onDelete: Restrict, no Cascade ni
  // SetNull — un registro legal append-only jamas debe poder quedar
  // huerfano de forma silenciosa (mismo criterio que Plan.coach frente a
  // User, y que RN-13 exige para todo registro con valor de trazabilidad
  // legal). Hoy es una salvaguarda que nunca se activa: no existe ningun
  // endpoint que borre un Plan.
  //
  // EPICA-05/D-14 (rama a): a partir de acceptConsent() esta tabla recibe
  // DOS filas por activacion de suscripcion (SPORT_CONSENT +
  // HEALTH_DATA_CONSENT), mismo userId y planId, documentType distinto —
  // sin cambio de schema: no existe ningun @@unique en este modelo que
  // pudiera bloquearlo (solo el @@index([userId]) de abajo).
  planId          String?      @map("plan_id")
  acceptedAt      DateTime     @default(now()) @map("accepted_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan?        @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("legal_acceptances")
}

// Registro append-only — sin updatedAt
model AuditLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  ip            String   @map("ip")
  userAgent     String   @map("user_agent")
  method        String   @map("method")
  url           String   @map("url")
  statusCode    Int?     @map("status_code")
  duration      Int?     @map("duration")
  correlationId String?  @map("correlation_id")
  error         String?  @map("error")

  // Que recursos toco el request. Sin esto, una busqueda cuyos criterios viajan
  // en el body (POST /coach-requests/search) deja constancia de que ALGUIEN
  // busco, pero no sobre los datos de QUIEN — y las reglas prohiben registrar el
  // body. Ante un reclamo de habeas data ("¿quien consulto mis datos?") el
  // rastro era insuficiente para esas rutas (hallazgo #9).
  //
  // Se guardan los IDs DEVUELTOS, no los criterios buscados: la pregunta legal
  // es quien accedio a los datos del titular, y una busqueda sin resultados no
  // divulgo nada. Los IDs si pueden registrarse; nombres, emails y documentos no.
  resourceType  String?  @map("resource_type")
  resourceIds   String[] @map("resource_ids")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([correlationId])
  // GIN: responde "¿quien consulto los datos de X?" con `resource_ids @> '{X}'`.
  // Un btree no sirve para contencion en arrays.
  @@index([resourceIds], type: Gin)
  @@map("audit_logs")
}

// Registro append-only — sin updatedAt
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// --- Modelos EPICA-09 ---

// Registro append-only — sin updatedAt (Ley 1273/2009)
// El estado es derivado en el service: USED si tokenUsedAt != null,
// EXPIRED si expiresAt < now(), ACTIVE en caso contrario.
// tokenUsedAt es la unica escritura posterior al INSERT — marca consumo atomico del token.
model AdminInvitation {
  id           String    @id @default(uuid())
  email        String    @map("email")
  tokenHash    String    @unique @map("token_hash")
  invitedBy    String    @map("invited_by")
  expiresAt    DateTime  @map("expires_at")
  tokenUsedAt  DateTime? @map("token_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  inviter      User      @relation("AdminInvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)

  // Indice para la query de verificacion de invitacion activa:
  // WHERE email = ? AND token_used_at IS NULL AND expires_at > now()
  @@index([email])
  @@map("admin_invitations")
}

// --- Modelos EPICA-02 ---

// Biblioteca global de ejercicios. `name` es la identidad del catalogo y vive
// aqui (no en ExerciseVersion): no se versiona, a diferencia de description/
// muscleGroup, que son contenido de entrenamiento (RN-05). Decision aceptada
// por el humano el 2026-08-05: corregir una errata de nombre debe propagarse
// a los planes historicos que ya referencian este ejercicio.
//
// Unicidad de `name`: SOLO entre ejercicios ACTIVOS, case-insensitive
// (CA-005-2/CA-005-6). NO se declara `@unique` en el campo ni un
// `@@unique([name])` a nivel de modelo — cualquiera de los dos rechazaria
// altas legitimas que CA-005-6 permite explicitamente (el nombre de un
// ejercicio inhabilitado queda libre para uno nuevo). La regla real requiere
// un indice UNICO PARCIAL con funcion (lower(name) ... WHERE is_active),
// que el schema declarativo de Prisma no puede expresar (no soporta indices
// funcionales ni parciales). Ver bloque de instrucciones abajo.
//
// ============================================================================
// INDICE PARCIAL REQUERIDO — el humano lo agrega a mano en la migracion:
//
//   CREATE UNIQUE INDEX "exercises_name_lower_active_key"
//     ON "exercises" (lower("name"))
//     WHERE "is_active" = true;
//
// Por que `lower("name")` sin trim(): el service SIEMPRE persiste `name` ya
// trimeado (create() y el rename de update()), asi que la columna nunca
// contiene espacios al inicio/fin — trim() en el indice seria redundante.
//
// Workflow recomendado (patron oficial de Prisma "Customizing migrations"):
//   1. pnpm prisma migrate dev --create-only --name add_exercises_catalog
//   2. Editar el migration.sql generado: pegar el CREATE UNIQUE INDEX de
//      arriba al final del archivo, despues de que Prisma cree la tabla
//      "exercises" y antes/despues de crear "exercise_versions" (el orden
//      entre ambas tablas no importa, solo que "exercises" ya exista).
//   3. pnpm prisma migrate dev   (aplica la migracion ya editada)
//
// Sobrevivencia ante un futuro `prisma migrate dev`: **NO se puede dar por
// sentada.** Este comentario razonaba que el motor de diff de Prisma Migrate
// opera sobre su representacion interna del datamodel (modelos/campos/
// @@index/@@unique declarados en schema.prisma), que un indice parcial con
// WHERE no es expresable ahi, y que por lo tanto es "literalmente invisible"
// para el diff y nunca se generaria un DROP INDEX. El razonamiento resulto
// NO ser confiable: el 2026-08-21, la migracion
// 20260821161654_epica_05_execution_and_prescription genero por si sola un
// `DROP INDEX "subscriptions_athlete_plan_active_key"` — el indice parcial
// gemelo de este, documentado con el mismo argumento en el modelo
// Subscription mas abajo. ESTE indice sobrevivio esa misma migracion, asi
// que el comportamiento no es uniforme y el argumento no predice cual cae.
//
// LO QUE HAY QUE HACER: despues de CADA `prisma migrate dev`, revisar el
// migration.sql generado buscando un DROP INDEX que nadie pidio, y verificar
// contra la base que los DOS indices parciales del proyecto siguen ahi:
//   SELECT indexname FROM pg_indexes
//    WHERE schemaname='public' AND indexname LIKE '%_active_key';
// Si falta alguno, restaurarlo con una migracion `--create-only` que
// contenga solo su CREATE UNIQUE INDEX (ver
// 20260821161837_restore_subscriptions_partial_unique_index como precedente).
//
// Sigue siendo necesario, ademas, que:
//   (a) el archivo de migracion con este SQL crudo permanezca en
//       prisma/migrations/ sin editar ni borrar — se re-ejecuta en cada
//       `prisma migrate reset` o reconstruccion de la shadow database;
//   (b) nadie corra `prisma db pull` sobre la tabla "exercises" — la
//       introspeccion inversa no reconstruye la clausula WHERE (Prisma no
//       soporta indices parciales en el schema declarativo) y sobreescribiria
//       schema.prisma desincronizandolo del estado real de la base de datos;
//   (c) nadie agregue `@unique` en `name` o `@@unique([name])` a este modelo
//       en una migracion futura — colisionaria con este indice parcial (dos
//       constraints de unicidad con semantica distinta sobre la misma
//       columna).
// Nota de rendimiento (no de correccion): el pre-check de unicidad en el
// service usa `where: { name: { equals, mode: 'insensitive' }, isActive:
// true }`, que Prisma traduce en PostgreSQL a `name ILIKE $1`, no a
// `lower(name) = $1`. Este indice parcial puede no ser aprovechado por el
// planner para ESA consulta especifica — es un tema de query-shape en el
// service, no un defecto del indice. Su funcion critica (cerrar la ventana
// de carrera a nivel de base de datos junto con el catch de P2002) es
// independiente de como se planifique el SELECT de precheck.
// ============================================================================
model Exercise {
  id        String   @id @default(uuid())
  name      String   @map("name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions  ExerciseVersion[]

  // Cubre GET /exercises (filtro por defecto isActive=true, paginado).
  // No se agrega indice propio sobre `name`: la unica consulta que filtra por
  // el, el pre-check de unicidad de create()/rename, ya queda cubierta por el
  // indice parcial de arriba en el caso comun, y no hay busqueda de texto
  // libre por name en el alcance de esta epica.
  @@index([isActive])
  @@map("exercises")
}

// Contenido versionado del ejercicio (RN-05): description y muscleGroup.
// A diferencia de LegalAcceptance (estrictamente append-only, cero UPDATE en
// todo el codebase), ExerciseVersion SI recibe una escritura UPDATE real:
// CA-006-3 edita in-place la version vigente (`exerciseVersion.update(...)`)
// mientras isUsedInPlan() sea false. Solo cuando el ejercicio ya esta en uso
// en un plan, update() pasa a comportarse append-only y crea una version
// nueva (CA-006-1) en vez de tocar la existente. Por eso SI lleva `updatedAt`
// -- omitirlo ocultaria cuando fue la ultima edicion in-place de la version
// vigente, informacion real que el service produce. Las versiones que ya
// fueron superadas por una mas reciente nunca vuelven a escribirse (ni
// siquiera su updatedAt cambia despues de quedar "vieja").
model ExerciseVersion {
  id            String   @id @default(uuid())
  exerciseId    String   @map("exercise_id")
  versionNumber Int      @map("version_number")
  description   String   @map("description")
  muscleGroup   String   @map("muscle_group")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // onDelete: Cascade — Exercise + ExerciseVersion son un unico agregado
  // (siempre se crean juntos en la misma $transaction; una ExerciseVersion
  // no tiene sentido sin su Exercise). Si algun dia se agrega un hard-delete
  // administrativo de Exercise (no expuesto en esta epica), sus versiones
  // deben desaparecer con el, igual que el patron ya usado en
  // CoachRequest/LegalAcceptance/RefreshToken -> User de este mismo schema.
  // NOTA (EPICA-03): esta cascada queda en tension deliberada con
  // SessionExercise.exerciseVersion (onDelete: Restrict) — ver el
  // comentario de ese modelo. Postgres bloquea el borrado de un Exercise
  // en cuanto alguna de sus versiones siga referenciada por un plan.
  // NOTA (EPICA-05): la misma tension se repite con
  // InstanceSessionExercise.exerciseVersion (onDelete: Restrict, D-13) —
  // ver ese modelo.
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  // Uso desde EPICA-03: una version puede ser referenciada por multiples
  // SessionExercise (el mismo ejercicio agregado a distintas sesiones o
  // planes mientras esa version siga vigente).
  sessionExercises SessionExercise[]

  // Uso desde EPICA-05: una version puede ser referenciada por multiples
  // InstanceSessionExercise (la copia profunda de HU-023 propaga el mismo
  // puntero congelado por la plantilla — D-13, sin volver a resolverlo).
  instanceSessionExercises InstanceSessionExercise[]

  // Cubre la consulta "version vigente" (orderBy versionNumber desc, take 1
  // filtrando por exerciseId) sin indice adicional: exerciseId es la columna
  // lider del indice compuesto que este @@unique ya crea. No se agrega un
  // puntero denormalizado currentVersionId en Exercise (ver decision del
  // plan de implementacion de EPICA-02).
  @@unique([exerciseId, versionNumber])
  @@map("exercise_versions")
}

// --- Modelos EPICA-03 ---

// Plan de entrenamiento (plantilla base del entrenador). Jerarquia completa
// confirmada por el humano el 2026-08-20: Plan -> Phase -> Week -> Session ->
// SessionExercise (RN-08). PlanStatus (enum arriba) ya trae exactamente los
// cuatro estados de RN-27 — NO se agrega `archivedAt`: ARCHIVED es uno de
// esos cuatro valores, no un flag de soft-delete adicional (decision D-7b
// del plan de implementacion). Tampoco existe una tabla `planHistory`: el
// rastro de mutaciones HTTP ya lo cubre AuditLog via AuditMiddleware
// (decision D-7c) — ninguna CA de esta epica pide un historial de
// transiciones distinto de eso.
model Plan {
  id          String     @id @default(uuid())
  name        String     @map("name")
  description String?    @map("description")
  startDate   DateTime?  @map("start_date")
  endDate     DateTime?  @map("end_date")
  status      PlanStatus @default(DRAFT) @map("status")
  coachId     String     @map("coach_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // onDelete: Restrict (no Cascade) — a diferencia de CoachRequest/
  // RefreshToken/LegalAcceptance (artefactos de identidad 1:1 con el
  // usuario), un Plan es contenido de negocio sustantivo que EPICA-04/05
  // referenciaran desde Subscription/SessionResult. Hoy no existe ningun
  // endpoint que borre un User, pero si alguna vez se agrega uno
  // administrativo, no debe poder arrastrar en cascada silenciosa los
  // planes (potencialmente publicados y visibles a atletas) de un
  // entrenador — mismo criterio ya usado en AdminInvitation.inviter.
  coach  User    @relation(fields: [coachId], references: [id], onDelete: Restrict)
  phases Phase[]

  // EPICA-04: lado inverso de Subscription.plan y LegalAcceptance.plan
  // (D-5). Sin @relation nombrado — cada modelo tiene una unica relacion
  // hacia Plan, a diferencia de las dos relaciones hacia User que si
  // requieren nombre (SubscriptionAthlete/SubscriptionReviewer).
  subscriptions     Subscription[]
  legalAcceptances  LegalAcceptance[]

  // EPICA-05: lado inverso de PlanInstance.plan — un plan (plantilla) puede
  // tener muchas instancias, una por atleta con suscripcion Activa (D-1).
  instances         PlanInstance[]

  // Cubre GET /plans (listado propio del entrenador, todos los estados).
  @@index([coachId])
  // Cubre el query mas caliente de la epica (HU-011, decision D-1): el
  // catalogo filtra SIEMPRE por `status = PUBLISHED AND endDate >= now()`
  // a nivel de query (evaluacion perezosa de Finalizado, sin job
  // programado). Columna de igualdad (status) primero, columna de rango
  // (endDate) despues — orden estandar para que un solo indice compuesto
  // sirva al filtro completo.
  @@index([status, endDate])
  @@map("plans")
}

// Fase de un plan (mesociclo: 3-8 semanas con un enfasis de entrenamiento,
// segun periodizacion NSCA — ver reporte de validacion de negocio).
// Estructura pura: hard-delete real en cascada mientras el plan sigue en
// Borrador (decision D-7); tras publicar, RN-31 la vuelve inmutable y ya no
// existe ninguna ruta de escritura que la toque. Por eso Phase/Week/Session/
// SessionExercise NO llevan `updatedAt`: ninguna tiene un endpoint de
// edicion — agregar la columna solo esconderia que nunca cambia despues del
// INSERT.
model Phase {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  name      String   @map("name")
  order     Int      @map("order")
  createdAt DateTime @default(now()) @map("created_at")

  plan  Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  weeks Week[]

  // Ancla para la FK compuesta de Week -> Phase (ver Week.phase abajo). No
  // sirve para busquedas por planId (id es la columna lider de este
  // indice) — esa consulta ya queda cubierta por @@unique([planId, order]).
  @@unique([id, planId])
  // order es calculado server-side (maximo existente en el plan + 1,
  // decision D-5). Esta unicidad por padre no es solo un indice de
  // rendimiento: es una salvaguarda de integridad contra dos altas
  // concurrentes de fase calculando el mismo "siguiente" order antes de que
  // la primera se persista. La columna lider (planId) ademas cubre "listar
  // fases de un plan" sin necesitar un indice adicional.
  @@unique([planId, order])
  @@map("phases")
}

// Semana (microciclo, segun periodizacion NSCA). weekNumber es secuencial a
// lo largo de TODO el plan, no reinicia por fase (decision D-4) — EPICA-05
// (WeekClosure, sensaciones semanales) lo necesita para comparar semanas
// entre fases.
//
// planId esta DENORMALIZADO desde phase.planId — recomendacion del
// Arquitecto, evaluada aqui y ACEPTADA, pero no a ciegas: la unicidad de
// weekNumber por plan (`@@unique([planId, weekNumber])`) es inexpresable en
// Prisma sin un campo planId propio en este modelo, porque el schema
// declarativo no puede construir una constraint de unicidad atravesando una
// relacion (Week -> Phase -> Plan). Rechazar la denormalizacion habria
// dejado esa unicidad como responsabilidad exclusiva del service (un
// SELECT+INSERT dentro de una transaccion, sin ninguna garantia a nivel de
// base de datos) — un nivel de proteccion inferior al que ya existe para el
// nombre de Exercise en EPICA-02.
//
// La inconsistencia que la denormalizacion podria introducir (una Week cuyo
// planId no coincida con el planId real de su Phase) queda cerrada A NIVEL
// DE BASE DE DATOS, no solo por disciplina del service: la relacion de abajo
// es una FK COMPUESTA `(phaseId, planId) -> Phase(id, planId)`, apoyada en
// `Phase.@@unique([id, planId])`. Postgres exige que el par exacto
// (phaseId, planId) exista como una fila real de Phase — es imposible
// insertar o actualizar una Week con un planId que no sea el de su propia
// Phase; el motor la rechaza con una violacion de FK ante cualquier intento,
// no solo cuando el service se equivoca.
model Week {
  id         String   @id @default(uuid())
  phaseId    String   @map("phase_id")
  planId     String   @map("plan_id")
  weekNumber Int      @map("week_number")
  createdAt  DateTime @default(now()) @map("created_at")

  phase    Phase     @relation(fields: [phaseId, planId], references: [id, planId], onDelete: Cascade)
  sessions Session[]

  @@unique([planId, weekNumber])
  @@index([phaseId])
  @@map("weeks")
}

// Sesion de entrenamiento dentro de una semana.
model Session {
  id        String   @id @default(uuid())
  weekId    String   @map("week_id")
  name      String   @map("name")
  order     Int      @map("order")
  createdAt DateTime @default(now()) @map("created_at")

  week      Week              @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises SessionExercise[]

  // Mismo criterio que Phase.@@unique([planId, order]): order es
  // server-side y su unicidad por padre (aqui, por semana) es salvaguarda
  // de integridad, no solo indice de rendimiento; la columna lider (weekId)
  // cubre ademas "listar sesiones de una semana".
  @@unique([weekId, order])
  @@map("sessions")
}

// Ejercicio dentro de una sesion del plan. Referencia SIEMPRE
// exerciseVersionId, NUNCA un exerciseId directo — es como se cumple RN-07:
// un plan conserva la version del ejercicio vigente al momento de agregarlo,
// aunque la biblioteca global lo modifique o inhabilite despues.
//
// EPICA-05/D-15 (EPICA-03 REABIERTA): 5 columnas de PRESCRIPCION, TODAS
// nullable — el entrenador bosqueja la sesion en Borrador sin volumenes; la
// completitud (regla de "prescripcion significativa", D-15 punto 2) se
// exige SOLO al publicar (`validatePlanCompleteness()`,
// plans.service.ts:989-1021), NUNCA como constraint de BD — Postgres no
// tiene forma declarativa de expresar "obligatorio en un momento del ciclo
// de vida, opcional en otro" sin un trigger, y este proyecto no usa SQL
// crudo mas alla de los indices parciales ya documentados en este archivo.
// Prescripcion y resultado (SessionExerciseResult, ver EPICA-05 abajo)
// comparten los MISMOS 5 nombres/tipos por decision explicita del humano
// (D-6), para que sean comparables uno a uno.
model SessionExercise {
  id                String   @id @default(uuid())
  sessionId         String   @map("session_id")
  exerciseVersionId String   @map("exercise_version_id")
  order             Int      @map("order")

  // Prescripcion (D-15). sets+reps (fuerza, loadKg opcional para peso
  // corporal) O durationSeconds/distanceMeters (resistencia, no se exige el
  // par) satisfacen "prescripcion significativa" — ver el detalle completo
  // de la regla en el plan de implementacion de EPICA-05, D-15 punto 2.
  // Unidad de loadKg/distanceMeters: kilogramos/metros por convencion, sin
  // RN/CA que la confirme explicitamente (riesgo documentado en el plan).
  sets              Int?     @map("sets")
  reps              Int?     @map("reps")
  loadKg            Float?   @map("load_kg")
  durationSeconds   Int?     @map("duration_seconds")
  distanceMeters    Float?   @map("distance_meters")

  createdAt         DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // onDelete: Restrict — un plan historico NUNCA debe perder esta
  // referencia. Hoy no existe ningun endpoint que borre una ExerciseVersion
  // ni un hard-delete de Exercise, pero Exercise -> ExerciseVersion SI es
  // Cascade (EPICA-02): si algun dia se agrega un hard-delete administrativo
  // de Exercise, este Restrict actua como salvaguarda de base de datos —
  // Postgres bloquea esa cascada en cuanto encuentra una ExerciseVersion
  // todavia referenciada por un SessionExercise, obligando a que la
  // decision de borrar pase primero por isUsedInPlan() en el service, igual
  // que ya exige EPICA-02 para inhabilitar un ejercicio en uso.
  exerciseVersion ExerciseVersion @relation(fields: [exerciseVersionId], references: [id], onDelete: Restrict)

  // order es server-side; unicidad por sesion, mismo criterio que Phase/Session.
  @@unique([sessionId, order])
  // Indice critico: isUsedInPlan(exerciseId) (decision D-2 del plan) hace
  // `sessionExercise.count({ where: { exerciseVersion: { exerciseId } } })`,
  // que hace JOIN contra exercise_versions y filtra session_exercises por
  // exercise_version_id. Este query corre en CADA PATCH de ejercicio (nota
  // explicita del plan de implementacion) — sin este indice seria un seq
  // scan de session_exercises en cada edicion del catalogo.
  @@index([exerciseVersionId])
  @@map("session_exercises")
}

// --- Modelos EPICA-04 ---

// Inscripcion de un atleta a un plan (RN-17, RN-18, RN-20, RN-27). Maquina
// de estados de 4 valores (SubscriptionStatus, ver enum arriba):
// PENDING -> APPROVED -> ACTIVE, con REJECTED como salida desde PENDING.
// A diferencia de Phase/Week/Session/SessionExercise (EPICA-03), SI lleva
// `updatedAt`: approve()/reject()/acceptConsent() son escrituras UPDATE
// reales sobre la misma fila (no append-only) — omitirlo esconderia cuando
// fue la ultima transicion de estado.
//
// El par (atleta, plan) puede repetirse legitimamente: CA-012-3 permite
// reintentar la solicitud tras un Rechazo, asi que NO se declara
// `@@unique([athleteId, planId])` a nivel de modelo — bloquearia ese
// reintento. La exclusividad real (CA-012-2: a lo sumo una suscripcion
// "viva" por atleta y plan) se implementa con un INDICE UNICO PARCIAL de
// PostgreSQL, no expresable en el schema declarativo de Prisma (no soporta
// indices parciales) — mismo mecanismo, mismo workflow y mismas garantias
// de sobrevivencia ya documentados arriba para `exercises_name_lower_active_key`
// (EPICA-02). Ver bloque de instrucciones abajo (decision D-3 del plan de
// implementacion de EPICA-04).
//
// ============================================================================
// INDICE PARCIAL REQUERIDO — el humano lo agrega a mano en la migracion:
//
//   CREATE UNIQUE INDEX "subscriptions_athlete_plan_active_key"
//     ON "subscriptions" ("athlete_id", "plan_id")
//     WHERE "status" IN ('PENDING', 'APPROVED', 'ACTIVE');
//
// Una fila REJECTED nunca colisiona con este indice — exactamente lo que
// CA-012-3 exige (reintento libre tras un rechazo). El pre-check en
// SubscriptionsService.create() (buscar una suscripcion propia en esos tres
// estados antes del INSERT) sigue siendo necesario para devolver
// SUBSCRIPTION_ALREADY_EXISTS con un mensaje claro en el caso comun; este
// indice es la salvaguarda de base de datos contra la ventana de carrera
// entre ese SELECT y el INSERT (dos solicitudes concurrentes del mismo
// atleta al mismo plan).
//
// Workflow (identico al de EPICA-02, ver Exercise arriba):
//   1. pnpm prisma migrate dev --create-only --name add_subscriptions
//   2. Editar el migration.sql generado: pegar el CREATE UNIQUE INDEX de
//      arriba al final del archivo, despues de que Prisma cree la tabla
//      "subscriptions".
//   3. pnpm prisma migrate dev   (aplica la migracion ya editada)
//
// Sobrevivencia ante un futuro `prisma migrate dev`: **NO sobrevive.**
// Esta seccion afirmaba lo contrario ("SI sobrevive, por el mismo motivo ya
// documentado para exercises_name_lower_active_key") y quedo REFUTADO en la
// practica el 2026-08-21: la PRIMERA migracion posterior a EPICA-04
// (20260821161654_epica_05_execution_and_prescription) abre con un
// `DROP INDEX "subscriptions_athlete_plan_active_key"` que Prisma genero
// solo, sin que nadie lo pidiera. En la MISMA migracion,
// "exercises_name_lower_active_key" SI sobrevivio — el comportamiento no es
// uniforme entre los dos indices parciales del proyecto y no puede darse por
// sentado para ninguno.
//
// Se restauro con la migracion 20260821161837_restore_subscriptions_partial_unique_index,
// que documenta el caso completo.
//
// LO QUE HAY QUE HACER: despues de CADA `prisma migrate dev`, revisar el
// migration.sql generado buscando un DROP INDEX que nadie pidio, y verificar
// contra la base:
//   SELECT indexname FROM pg_indexes
//    WHERE schemaname='public' AND indexname LIKE '%_active_key';
// Deben aparecer LOS DOS. Si falta alguno, restaurarlo con una migracion
// `--create-only` que contenga solo su CREATE UNIQUE INDEX.
//
// Sigue valiendo, ademas, que: (a) el archivo de migracion con este SQL crudo
// debe permanecer en prisma/migrations/ sin editar ni borrar; (b) nadie debe
// correr `prisma db pull` sobre la tabla "subscriptions"; (c) nadie debe
// agregar `@@unique([athleteId, planId])` a este modelo — colisionaria con
// este indice parcial.
//
// POR QUE IMPORTA que no falte: es la salvaguarda de BD de CA-012-2. El
// pre-check de SubscriptionsService.create() cubre el caso comun, pero no la
// ventana de carrera entre su SELECT y el INSERT — sin el indice, dos
// solicitudes concurrentes del mismo atleta al mismo plan pasan las dos, y el
// catch de P2002 del service no tiene nada que atrapar.
// ============================================================================
model Subscription {
  id          String             @id @default(uuid())
  athleteId   String             @map("athlete_id")
  planId      String             @map("plan_id")
  status      SubscriptionStatus @default(PENDING) @map("status")

  // Escritos juntos por approve()/reject() (HU-013) — quien decidio y
  // cuando. Sin motivo de rechazo (decision D-4 del plan): a diferencia de
  // CoachRequest.rejectionReason, ninguna CA de HU-013 pide capturarlo.
  reviewedAt  DateTime?          @map("reviewed_at")
  reviewedBy  String?            @map("reviewed_by")

  // Escrito por acceptConsent() (HU-014, CA-014-2) en la misma
  // $transaction que crea el LegalAcceptance(SPORT_CONSENT) — momento en
  // que la suscripcion pasa a ACTIVE. null mientras status esta en
  // PENDING/APPROVED/REJECTED. EPICA-05/D-14 (rama a): la misma
  // $transaction ahora ADEMAS crea un LegalAcceptance(HEALTH_DATA_CONSENT)
  // — sin impacto de schema, DocumentType.HEALTH_DATA_CONSENT ya existe.
  activatedAt DateTime?          @map("activated_at")

  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // onDelete: Restrict en ambas relaciones (no Cascade) — mismo criterio ya
  // documentado en Plan.coach: Subscription es contenido de negocio
  // sustantivo (historial de inscripcion de un atleta a un plan, con
  // implicaciones sobre RN-17/RN-18/RN-20), no un artefacto de identidad
  // 1:1 como CoachRequest/RefreshToken. Hoy no existe ningun endpoint que
  // borre un User ni un Plan, pero si alguna vez se agrega uno
  // administrativo, no debe poder arrastrar en cascada silenciosa el
  // historial de inscripciones.
  athlete  User  @relation("SubscriptionAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  plan     Plan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  // onDelete: SetNull — mismo criterio que CoachRequest.reviewer: es un
  // campo de auditoria sobre QUIEN decidio, no informacion estructural de
  // la suscripcion; perderla ante el borrado del coach no compromete la
  // integridad del registro (el estado APPROVED/REJECTED y reviewedAt
  // se mantienen).
  reviewer User? @relation("SubscriptionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  // EPICA-05: lado inverso de PlanInstance.subscription — 1:1, D-3. Optional
  // porque una Subscription puede existir sin instancia todavia (ventana de
  // carrera entre la activacion y el listener/self-heal de D-3).
  instance PlanInstance?

  // Cubre GET /subscriptions (listado propio del atleta, todos los
  // estados, paginado).
  @@index([athleteId])
  // Compuesto, columna lider planId: cubre DOS consultas sin necesitar un
  // indice adicional. (1) hasSubscribers(planId) en PlansService —
  // `count({ where: { planId, status: { in: [APPROVED, ACTIVE] } } })`,
  // que corre en cada intento de unpublish() (cierra el gap declarado de
  // CA-009-7 de EPICA-03). (2) GET /subscriptions/pending (HU-013): tras
  // resolver los planId propios del coach via Plan.@@index([coachId]), el
  // filtro `planId IN (...) AND status = PENDING` usa este mismo indice.
  @@index([planId, status])
  @@map("subscriptions")
}

// --- Modelos EPICA-05 ---
//
// Instancia personalizada del atleta (HU-023, HU-015, HU-016, HU-017).
// Jerarquia PlanInstance -> InstancePhase -> InstanceWeek -> InstanceSession
// -> InstanceSessionExercise, copia profunda de Plan -> Phase -> Week ->
// Session -> SessionExercise (D-1) — mismos nombres de campo, mismo patron
// de FK compuesta para la unicidad de weekNumber por instancia, mismo
// criterio de "sin updatedAt" en la estructura pura (nadie la edita despues
// de creada — RN-31, solo duracion/fases inmutables, contenido lo modula
// EPICA-06 fuera de este alcance).
//
// SessionResult/SessionExerciseResult (D-6) y WeeklyFeeling SI llevan
// updatedAt: reciben escrituras UPDATE reales via upsert (D-6b) mientras la
// semana este abierta. RN-09 (inmutabilidad tras cierre de semana) NO se
// expresa en el schema — Postgres no tiene una forma declarativa de
// bloquear un UPDATE condicionado al estado de OTRA fila (InstanceWeek.
// isClosed) sin un trigger, y este proyecto no usa SQL procedural mas alla
// de los indices parciales ya documentados arriba. El congelamiento es
// EXCLUSIVAMENTE responsabilidad del service (chequeo inline WEEK_FROZEN
// antes de cualquier upsert, D-11) — ninguna de estas tres tablas es
// append-only en el sentido de LegalAcceptance/AuditLog.
//
// Control de acceso a datos sensibles de salud (WeeklyFeeling, CA-016-6,
// Ley 1581/2012): el schema NO implementa ningun mecanismo de fila (no hay
// Row Level Security de Postgres en este proyecto) — la restriccion "solo
// el atleta titular y el entrenador del plan" se resuelve INTEGRAMENTE en
// la capa de servicio, con el mismo patron de ownership ya usado en el
// resto del proyecto (findOwnSubscriptionOrFail/findOwnedOrFail, D-11). El
// unico aporte del schema es no crear ninguna via de acceso adicional:
// WeeklyFeeling no se referencia desde ningun otro modelo mas que
// InstanceWeek, y su unico indice es el `@unique` de esa FK.

// Contenedor raiz de la instancia (D-1). El constraint UNICO sobre
// subscriptionId es el mecanismo de idempotencia de CA-023-8 (D-3): el
// listener de subscription.activated y el self-heal de GET /instances/:planId
// llaman al mismo getOrCreateInstance(), que hace
// `findUnique({ subscriptionId })` primero y, si no existe, crea dentro de
// un $transaction interactivo; el service captura P2002 como salvaguarda
// ante la ventana de carrera entre ambos pasos — mismo patron que
// SubscriptionsService.create() con el indice parcial de Subscription.
model PlanInstance {
  id             String   @id @default(uuid())
  planId         String   @map("plan_id")
  athleteId      String   @map("athlete_id")
  subscriptionId String   @unique @map("subscription_id")
  createdAt      DateTime @default(now()) @map("created_at")

  // onDelete: Restrict en las tres relaciones — mismo criterio que
  // Subscription: contenido de negocio sustantivo (el historial de
  // ejecucion del atleta, insumo de EPICA-07/08), no un artefacto de
  // identidad 1:1. Restrict en `subscription` ademas protege el mecanismo
  // de idempotencia de D-3: la instancia nunca debe quedar huerfana de
  // forma silenciosa.
  plan         Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  athlete      User            @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  phases       InstancePhase[]

  // Cubre GET /instances (listado propio del atleta, resumen liviano,
  // CA-023-4/CA-023-5). El detalle GET /instances/:planId y el panel del
  // entrenador resuelven la instancia via `subscriptionId` (unique, arriba)
  // despues de validar la Subscription Activa — no necesitan este indice.
  @@index([athleteId])
  @@map("plan_instances")
}

// Fase de la instancia — copia estructural 1:1 de Phase (D-1, CA-023-3).
model InstancePhase {
  id         String   @id @default(uuid())
  instanceId String   @map("instance_id")
  order      Int      @map("order")
  createdAt  DateTime @default(now()) @map("created_at")

  instance PlanInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  weeks    InstanceWeek[]

  // Ancla para la FK compuesta de InstanceWeek -> InstancePhase, mismo
  // patron que Phase.@@unique([id, planId]) en EPICA-03.
  @@unique([id, instanceId])
  // order se copia de la plantilla en la $transaction de creacion (D-1);
  // esta unicidad por padre es la misma salvaguarda de integridad que
  // Phase.@@unique([planId, order]), y su columna lider (instanceId) cubre
  // "listar fases de una instancia" sin indice adicional.
  @@unique([instanceId, order])
  @@map("instance_phases")
}

// Semana de la instancia — copia estructural 1:1 de Week (D-1). instanceId
// esta DENORMALIZADO desde instancePhase.instanceId, mismo criterio que
// Week.planId: permite `@@unique([instanceId, weekNumber])` con weekNumber
// secuencial a lo largo de TODA la instancia (no por fase), y la FK
// compuesta `(instancePhaseId, instanceId) -> InstancePhase(id, instanceId)`
// cierra la consistencia a nivel de base de datos, no solo por disciplina
// del service.
//
// isClosed/closedAt (D-5, Frozen Flag) viven DIRECTAMENTE aqui, NO en una
// tabla WeekClosure separada — desviacion deliberada del ejemplo ilustrativo
// del skill design-patterns (§5), para evitar un join en el chequeo mas
// caliente de la epica (verificar si la semana esta cerrada antes de
// cualquier escritura de resultado/sensacion). No revertir a una tabla
// separada sin una nueva decision explicita.
model InstanceWeek {
  id              String    @id @default(uuid())
  instancePhaseId String    @map("instance_phase_id")
  instanceId      String    @map("instance_id")
  weekNumber      Int       @map("week_number")
  isClosed        Boolean   @default(false) @map("is_closed")
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  instancePhase InstancePhase     @relation(fields: [instancePhaseId, instanceId], references: [id, instanceId], onDelete: Cascade)
  sessions      InstanceSession[]
  feeling       WeeklyFeeling?

  @@unique([instanceId, weekNumber])
  @@index([instancePhaseId])
  @@map("instance_weeks")
}

// Sesion de la instancia — copia estructural 1:1 de Session (D-1).
model InstanceSession {
  id             String   @id @default(uuid())
  instanceWeekId String   @map("instance_week_id")
  name           String   @map("name")
  order          Int      @map("order")
  createdAt      DateTime @default(now()) @map("created_at")

  instanceWeek InstanceWeek              @relation(fields: [instanceWeekId], references: [id], onDelete: Cascade)
  exercises    InstanceSessionExercise[]
  result       SessionResult?

  // order se copia de la plantilla (D-1); mismo criterio de integridad que
  // Session.@@unique([weekId, order]). La columna lider (instanceWeekId) es
  // ademas el indice que sostiene el conteo mas caliente de la epica (D-4):
  // `InstanceSession.count({ where: { instanceWeekId, result: null } })`
  // corre DENTRO de la $transaction de POST .../results en CADA registro,
  // para decidir si la semana cierra. El filtro `result: null` se resuelve
  // como anti-join contra SessionResult.instanceSessionId (unique, ver
  // abajo), no necesita indice propio adicional aqui.
  @@unique([instanceWeekId, order])
  @@map("instance_sessions")
}

// Ejercicio dentro de una sesion de la instancia — copia estructural de
// SessionExercise, MAS los 5 campos de prescripcion copiados TAL CUAL desde
// la plantilla en el momento de la copia profunda (CA-023-9, D-15 punto 8):
// mismos nombres/tipos que SessionExercise, para comparabilidad uno a uno
// contra SessionExerciseResult.
model InstanceSessionExercise {
  id                String   @id @default(uuid())
  instanceSessionId String   @map("instance_session_id")
  // exerciseVersionId se copia TAL CUAL desde SessionExercise.exerciseVersionId
  // de la plantilla — el service de esta epica NUNCA vuelve a resolver la
  // version vigente del ejercicio (D-13, RN-07 ya resuelta por EPICA-03 al
  // momento en que el entrenador agrego el ejercicio a la sesion).
  exerciseVersionId String  @map("exercise_version_id")
  order             Int     @map("order")

  sets              Int?    @map("sets")
  reps              Int?    @map("reps")
  loadKg            Float?  @map("load_kg")
  durationSeconds   Int?    @map("duration_seconds")
  distanceMeters    Float?  @map("distance_meters")

  createdAt         DateTime @default(now()) @map("created_at")

  instanceSession InstanceSession @relation(fields: [instanceSessionId], references: [id], onDelete: Cascade)

  // onDelete: Restrict — mismo criterio y misma tension deliberada que
  // SessionExercise.exerciseVersion (prisma/schema.prisma, EPICA-03): un
  // registro historico de ejecucion (y su resultado, si existe) NUNCA debe
  // perder la referencia a la version exacta del ejercicio que el atleta
  // realizo, aunque algun dia se agregue un hard-delete administrativo de
  // Exercise/ExerciseVersion. Esto bloquea la cascada de InstanceSession
  // hacia abajo en cuanto un ejercicio de sesion sigue referenciado.
  exerciseVersion ExerciseVersion @relation(fields: [exerciseVersionId], references: [id], onDelete: Restrict)

  result SessionExerciseResult?

  // order se copia de la plantilla; mismo criterio de integridad que
  // SessionExercise.@@unique([sessionId, order]).
  @@unique([instanceSessionId, order])
  // A diferencia de SessionExercise.@@index([exerciseVersionId]) (que en la
  // plantilla cubre isUsedInPlan(), una query de `plans` que no aplica
  // aqui), este indice se justifica por integridad referencial: sostiene el
  // chequeo de Postgres para el onDelete: Restrict de arriba sin seq scan
  // sobre una tabla que crece con cada suscripcion activada.
  @@index([exerciseVersionId])
  @@map("instance_session_exercises")
}

// Registro agregado del resultado de UNA sesion de la instancia (HU-015,
// D-6) — casi vacio de datos propios; los valores tipados viven en su hijo
// SessionExerciseResult. Por construccion del service (paso RESULT_FIELDS_INVALID
// ANTES del upsert, CA-015-10), esta fila NUNCA existe en estado parcial:
// cuando existe, ya tiene un SessionExerciseResult por cada ejercicio
// programado de la sesion (D-4).
//
// athleteId esta DENORMALIZADO — insumo declarado por el plan para consultas
// futuras de EPICA-07/EPICA-08 sobre el historico de un atleta sin atravesar
// toda la cadena InstanceSession -> InstanceWeek -> InstancePhase ->
// PlanInstance. NO se le agrega indice en esta epica: ningun endpoint de
// EPICA-05 filtra SessionResult por athleteId de forma independiente (los
// resultados siempre se leen embebidos en el arbol de la instancia, ya
// resuelto via ownership) — se deja para cuando EPICA-07/08 declaren su
// propia query real, siguiendo el criterio de "no sobre-indexar".
//
// onDelete: Restrict hacia InstanceSession (no Cascade) — tension deliberada
// con InstanceWeek -> InstanceSession (Cascade): protege este resultado de
// negocio (insumo de IA/metricas) de una cascada silenciosa, mismo patron
// que ExerciseVersion/SessionExercise ya documentado arriba.
model SessionResult {
  id                String   @id @default(uuid())
  instanceSessionId String   @unique @map("instance_session_id")
  athleteId         String   @map("athlete_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  instanceSession InstanceSession         @relation(fields: [instanceSessionId], references: [id], onDelete: Restrict)
  athlete         User                    @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  exerciseResults SessionExerciseResult[]

  @@map("session_results")
}

// Hijo tipado de SessionResult (D-6): un resultado por ejercicio de sesion
// como maximo (`instanceSessionExerciseId` unico). MISMOS 5 campos que la
// prescripcion de InstanceSessionExercise — comparables uno a uno — mas
// `notes`, que SOLO el resultado tiene. Sin updatedAt propio: cualquier
// edicion de un hijo se refleja en el updatedAt del padre (SessionResult),
// que ya identifica cuando se toco por ultima vez esta sesion — evita
// duplicar la marca de tiempo en cada fila hija (D-6).
model SessionExerciseResult {
  id                        String   @id @default(uuid())
  sessionResultId           String   @map("session_result_id")
  instanceSessionExerciseId String   @unique @map("instance_session_exercise_id")

  sets            Int?    @map("sets")
  reps            Int?    @map("reps")
  loadKg          Float?  @map("load_kg")
  durationSeconds Int?    @map("duration_seconds")
  distanceMeters  Float?  @map("distance_meters")
  notes           String? @map("notes")

  createdAt DateTime @default(now()) @map("created_at")

  // onDelete: Cascade — a diferencia de la relacion hacia
  // InstanceSessionExercise (abajo), SessionResult+SessionExerciseResult son
  // un unico agregado (siempre se upsertan juntos en la misma $transaction,
  // D-4): un SessionExerciseResult no tiene sentido sin su SessionResult
  // padre, mismo criterio que Exercise -> ExerciseVersion (EPICA-02).
  sessionResult SessionResult @relation(fields: [sessionResultId], references: [id], onDelete: Cascade)

  // onDelete: Restrict — mismo criterio que SessionResult.instanceSession:
  // protege este resultado (insumo de IA/metricas) de una cascada silenciosa
  // si InstanceSessionExercise fuera borrado, bloqueando a su vez la cascada
  // de InstanceSession hacia abajo.
  instanceSessionExercise InstanceSessionExercise @relation(fields: [instanceSessionExerciseId], references: [id], onDelete: Restrict)

  // sessionResultId no es unico (1:N) — este indice sostiene el fetch de
  // `exerciseResults` embebido en SessionResultResponseDto dentro de
  // GET /instances/:planId(/athletes/:athleteId) (D-2), que trae TODOS los
  // hijos de un SessionResult en una sola consulta.
  @@index([sessionResultId])
  @@map("session_exercise_results")
}

// Sensaciones semanales del atleta (HU-016) — dolor muscular y motivacion,
// enteros de 1 a 10 ambos inclusive (D-6, RESUELTA). DATO SENSIBLE DE SALUD
// bajo la Ley 1581/2012 (CA-016-6): el schema no implementa ningun control
// de acceso por fila (no hay Row Level Security en este proyecto) — la
// restriccion de lectura al atleta titular y al entrenador del plan se
// resuelve INTEGRAMENTE en la capa de servicio (ver nota de cabecera de esta
// seccion). SI lleva updatedAt: upsert real (D-6b) mientras la semana este
// abierta; el congelamiento tras el cierre (RN-09) es un chequeo inline del
// service (WEEK_FROZEN), no una restriccion de este schema.
//
// onDelete: Restrict hacia InstanceWeek — mismo patron de tension deliberada
// que SessionResult/SessionExerciseResult: protege este dato sensible de una
// cascada silenciosa, bloqueando la cascada de InstancePhase -> InstanceWeek
// mientras la semana conserve sensaciones registradas.
model WeeklyFeeling {
  id             String   @id @default(uuid())
  instanceWeekId String   @unique @map("instance_week_id")
  muscleSoreness Int      @map("muscle_soreness")
  motivation     Int      @map("motivation")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  instanceWeek InstanceWeek @relation(fields: [instanceWeekId], references: [id], onDelete: Restrict)

  @@map("weekly_feelings")
}

