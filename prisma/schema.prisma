// MIGRACION DE DATOS REQUERIDA (D-15 punto 10, migracion 1 —
// add_session_exercise_prescription) — el humano la agrega a mano en el
// migration.sql, DESPUES del ALTER TABLE que agrega las 5 columnas nuevas a
// "session_exercises":
//
//   UPDATE "plans"
//   SET "status" = 'DRAFT'
//   WHERE "status" = 'PUBLISHED'
//     AND "id" IN (
//       SELECT DISTINCT p."id"
//       FROM "plans" p
//       JOIN "phases" ph ON ph."plan_id" = p."id"
//       JOIN "weeks" w ON w."phase_id" = ph."id"
//       JOIN "sessions" s ON s."week_id" = w."id"
//       JOIN "session_exercises" se ON se."session_id" = s."id"
//       WHERE NOT (
//         (se."sets" IS NOT NULL AND se."reps" IS NOT NULL)
//         OR (se."duration_seconds" IS NOT NULL OR se."distance_meters" IS NOT NULL)
//       )
//     );
//
// Revierte a Borrador todo plan Publicado que tenga al menos un
// SessionExercise sin "prescripcion significativa" (D-15 punto 2) — SIN
// backfill con valores inventados. NO pasa por unpublish() ni por su guard
// PLAN_HAS_SUBSCRIBERS (es una operacion de datos directa, no una llamada
// HTTP — ver D-15 punto 10 del plan de implementacion).
//
// Verificacion post-migracion (no automatizada, criterio de aceptacion
// tecnico del plan): debe devolver CERO filas.
//
//   SELECT p."id", p."name"
//   FROM "plans" p
//   JOIN "phases" ph ON ph."plan_id" = p."id"
//   JOIN "weeks" w ON w."phase_id" = ph."id"
//   JOIN "sessions" s ON s."week_id" = w."id"
//   JOIN "session_exercises" se ON se."session_id" = s."id"
//   WHERE p."status" = 'PUBLISHED'
//     AND NOT (
//       (se."sets" IS NOT NULL AND se."reps" IS NOT NULL)
//       OR (se."duration_seconds" IS NOT NULL OR se."distance_meters" IS NOT NULL)
//     );
//
// ADVERTENCIA (no aplica a produccion, que no tiene usuarios, pero SI puede
// aplicar a la base de datos de desarrollo del humano): este UPDATE no
// distingue si el plan revertido tiene Subscription APPROVED/ACTIVE. Un
// plan con una suscripcion Activa que se revierte a Borrador queda en un
// estado que el codigo actual nunca previo (PlansService no tiene guard
// para "publicar de nuevo con suscriptores existentes" mas alla de
// PLAN_HAS_SUBSCRIBERS en unpublish(), que este script no ejecuta). Antes de
// aplicar esta migracion en una base de desarrollo con datos de prueba,
// correr primero la consulta de verificacion de arriba, cruzarla con
// `subscriptions` (`status IN ('APPROVED','ACTIVE')`) y decidir manualmente
// si alguno de esos planes necesita su prescripcion completada a mano ANTES
// de la migracion, en vez de dejarlo revertir.
// ============================================================================
